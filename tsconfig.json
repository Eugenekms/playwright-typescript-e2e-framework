{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@fixtures/*": ["./fixtures/*"],
            "@pages/*": ["./pages/*"],
            "@utils/*": ["./utils/*"]
        },
        "types": ["node"]
    }
}
